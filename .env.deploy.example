# Deploy config for the private ThinkPad instance (or a small trusted-LAN trial).
# Copy to .env.deploy (gitignored), fill in real values, then use the personal launcher:
#
#   pwsh -File scripts\start-compcat.ps1
#
# Do not reuse this file for scripts\public. The public mode has a separate env file,
# Compose project, database, and exposure policy. See docs/RUN-MODES.md.
#
# Generate the two secrets (do NOT reuse the repo's local-* defaults):
#   openssl rand -hex 32

# production makes the app REFUSE to boot on the repo's default secret/salt,
# so the two values below must be real randoms.
MCA_ENVIRONMENT=production

MCA_SESSION_SECRET=__run: openssl rand -hex 32__
MCA_USER_HASH_SALT=__run: openssl rand -hex 32__

# Token that guards the admin crime-ingest endpoint (pick any strong random).
#   openssl rand -hex 24
MCA_ADMIN_INGEST_TOKEN=__run: openssl rand -hex 24__

# Internal HTTP trial: keep false (cookies work over plain HTTP).
# Behind HTTPS (recommended even internally): set true.
MCA_SESSION_COOKIE_SECURE=false

# Personal location-history upload. Enabled for the single-host ThinkPad trial: the parser
# pipeline discards raw points after clustering (MCA_RAW_UPLOAD_RETENTION stays false) and
# users can delete their uploaded data. KEEP THIS OFF for any shared/multi-user or public
# deploy until production auth, encryption-at-rest, and per-user tenant isolation land
# (see README "Roadmap (not yet implemented)").
MCA_PUBLIC_ENABLE_PERSONAL_UPLOADS=true
# Keep-only-clusters: raw points + per-visit stops are discarded after clustering.
# Set true only to retain raw points for re-clustering.
MCA_RAW_UPLOAD_RETENTION=false

# Optional: a Socrata app token raises ingest rate limits. Leave blank otherwise.
SOCRATA_APP_TOKEN=

# The assistant calls an OpenAI-compatible model gateway (e.g. llama-swap /v1).
# Must be reachable from the container (a LAN IP, or host.docker.internal:PORT — not 127.0.0.1).
MCA_LLM_BASE_URL=http://<llm-host-lan-ip>:8080/v1
MCA_LLM_MODEL=gemma-4-26b-a4b-it-ud-q4-k-m-ctx32k
# OpenAI-compatible read timeout. The GPT-OSS installer changes this private value to 300.
MCA_LLM_TIMEOUT_S=120
MCA_ASSISTANT_NARRATION_ENABLED=true
# Optional one-time local GPT-OSS 120B install + activation (about 59 GiB):
#   pwsh -File scripts\install-gpt-oss-120b.ps1 -ActivateForCompCat
# The installer backs up this file, selects openai/gpt-oss-120b, and raises its timeout to 300s.
# Optional automatic failover to a second node (used only when BOTH are set).
MCA_LLM_FALLBACK_BASE_URL=http://<llm-fallback-host-lan-ip>:8080/v1
MCA_LLM_FALLBACK_MODEL=qwen3.6-27b-q4-k-m-ctx32k
# Disable chain-of-thought per endpoint. Qwen "thinking" models otherwise spend the
# whole token budget on reasoning_content and return empty content.
MCA_LLM_DISABLE_THINKING=false
MCA_LLM_FALLBACK_DISABLE_THINKING=true

# Backend selection — default "openai" (the compatible gateway above). To use a hosted SDK
# provider instead, set MCA_LLM_PROVIDER and the matching keys:
# MCA_LLM_PROVIDER=anthropic
# MCA_ANTHROPIC_API_KEY=
# MCA_ANTHROPIC_MODEL=claude-sonnet-5
#   — or —
# MCA_LLM_PROVIDER=openai_native
# MCA_OPENAI_API_KEY=
# MCA_OPENAI_MODEL=gpt-4o
# MCA_LLM_FALLBACK_PROVIDER picks the failover slot independently (e.g. Claude primary + local fallback).

# Geocoding — REQUIRED in production: an identifiable contact per Nominatim policy.
MCA_GEOCODER_PROVIDER=nominatim
MCA_GEOCODER_BASE_URL=https://nominatim.openstreetmap.org/search
MCA_GEOCODER_USER_AGENT=CompCat/0.1
MCA_GEOCODER_CONTACT_EMAIL=ops@example.com
MCA_GEOCODER_CACHE_TTL_DAYS=30
MCA_GEOCODER_MAX_RESULTS=5
MCA_GEOCODER_TIMEOUT_S=5.0
MCA_GEOCODER_MIN_INTERVAL_S=1.0
