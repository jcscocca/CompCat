# Versioned reference-frame metadata hashes canonical LF bytes. Keep these generated
# assets stable across Windows, macOS, and Linux checkouts.
app/data/seattle_street_segment_midpoints_v1.csv text eol=lf
app/data/seattle_street_segment_midpoints_v1.json text eol=lf

# Linux ops entry points and crond configuration are bind-mounted from Windows.
# Preserve executable shell syntax and cron records in every checkout.
deploy/*.sh text eol=lf
deploy/*.crontab text eol=lf
tests/ops_entrypoint_smoke.sh text eol=lf
