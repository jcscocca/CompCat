# CompCat public posture for the ThinkPad-hosted instance at https://compcat.app, served
# through a NAMED Cloudflare tunnel. Copy to .env.tunnel (gitignored) on the ThinkPad, fill in
# every __placeholder__, then:
#
#   pwsh -File scripts\public\start-public.ps1
#
# Full runbook: docs/DEPLOY-TUNNEL.md. This is the same production posture as
# .env.prod.example (the VPS path) with two differences, both about the edge: there is no
# Caddy here, and CLOUDFLARE_TUNNEL_TOKEN at the bottom is what publishes the site.
#
# It is a SEPARATE instance from the personal ThinkPad stack (.env.deploy): its own compose
# project, its own database volume, its own secrets. Never point this file at the personal
# instance's database — that one has real saved places and personal uploads enabled, and must
# never be exposed.

# Production mode: the app REFUSES to boot on placeholder secrets, requires a geocoder
# contact, and forces secure session cookies. Do not set this to anything else here.
MCA_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Secrets — generate fresh values; never reuse the personal instance's or the demo's.
# ---------------------------------------------------------------------------
#   openssl rand -hex 32     (Git Bash / WSL on Windows; or `python -c "import secrets;print(secrets.token_hex(32))"`)
MCA_SESSION_SECRET=__run: openssl rand -hex 32__
# Must be explicit: the base compose file defaults this var to "false", which would override
# the app's automatic secure-in-production behavior. Cloudflare serves the site over HTTPS
# only, so there is no plain-HTTP hop for the cookie to leak on — but state it anyway.
MCA_SESSION_COOKIE_SECURE=true
MCA_USER_HASH_SALT=__run: openssl rand -hex 32__
#   openssl rand -hex 24   (admin ingest header X-Admin-Token; an empty value closes the
#   endpoint entirely, which also stops the nightly ingest sidecar from working)
MCA_ADMIN_INGEST_TOKEN=__run: openssl rand -hex 24__

# Database. These two must agree: POSTGRES_PASSWORD initializes the db container on first
# boot, MCA_DATABASE_URL is how the api connects. Both are required with no default — the
# prod overlay refuses to render if either is missing. The db is never published on the host,
# so this password is only ever used inside the compose network.
#   openssl rand -hex 24
POSTGRES_PASSWORD=__run: openssl rand -hex 24__
MCA_DATABASE_URL=postgresql+psycopg://mca:__same password as above__@db:5432/mca

# ---------------------------------------------------------------------------
# Request limits — ON. A hosted LLM key with the limiter off makes the app refuse to boot.
# Conservative starting values; raise them once real traffic is boring.
# ---------------------------------------------------------------------------
MCA_RATE_LIMIT_ENABLED=true
MCA_RATE_LIMIT_SESSIONS_PER_HOUR=10
MCA_RATE_LIMIT_ASSISTANT_PER_HOUR=60
# Per-IP assistant cap. The per-session bucket above is reset by asking for a new session
# cookie, so this is the tier that actually bounds one caller.
MCA_RATE_LIMIT_ASSISTANT_PER_IP_PER_HOUR=90
# Shared daily ceiling across ALL callers — an outage backstop, not the primary throttle.
# The token budget below is the real spend guard; this one only exists to bound a runaway.
# Keep it well clear of legitimate demand: the independent per-IP tier limits any single
# caller to 90 requests per rolling hour, and the token budget remains a second spend rail.
MCA_RATE_LIMIT_ASSISTANT_GLOBAL_PER_DAY=500
MCA_RATE_LIMIT_BURST_PER_MINUTE=120
MCA_RATE_LIMIT_TILES_PER_MINUTE=600
MCA_RATE_LIMIT_HEALTH_PER_MINUTE=120
MCA_MAX_REQUEST_BYTES=1048576

# Shared daily LLM token budget (prompt + completion, every assistant call, UTC day; 0
# disables it). 2,000,000 is roughly 1,000 assistant turns at ~2k tokens each — of the same
# order as the 500/day global call cap above, so whichever binds first ends the day; the
# budget is the spend backstop for unusually long turns rather than the primary throttle.
# Once it is spent, free-text chat declines for the rest of the UTC day and everything else
# in the app keeps working.
MCA_ASSISTANT_TOKEN_BUDGET_PER_DAY=2000000

# Client identity comes from the tunnel. HERE CLOUDFLARE IS THE EDGE: every request reaches
# the app through cloudflared, which injects CF-Connecting-IP with the true client address,
# and the limiter reads that header first (app/ratelimit.py). Nothing else can reach the app —
# docker-compose.tunnel.yml publishes no host port at all — so the header cannot be forged.
#
# This is the opposite of the VPS posture, where Caddy is the edge and deploy/Caddyfile
# deliberately STRIPS CF-Connecting-IP (`header_up -CF-Connecting-IP`) because there a client
# could set it themselves and mint a fresh rate bucket per request. Same header, opposite
# treatment, because the trusted hop is different. Without this var, every visitor on Earth
# shares one rate bucket.
MCA_TRUST_PROXY_HEADERS=true
# Cloudflare's single-valued header is authoritative here. Do not fall back to the
# chain-dependent XFF header.
MCA_TRUST_X_FORWARDED_FOR=false

# ---------------------------------------------------------------------------
# Exposure — both OFF, deliberately, on a public instance.
# ---------------------------------------------------------------------------
# Personal location-history uploads store real personal data against an anonymous session.
# OFF: POST /uploads returns 404 and no upload UI renders. Authenticated DELETE /uploads
# remains available for erasure. (The personal ThinkPad instance has new uploads ON — one
# more reason this is a separate compose project with its own database.)
MCA_PUBLIC_ENABLE_PERSONAL_UPLOADS=false
# The /internal/* tier is unauthenticated by design (it accepts a demo-identity fallback).
# OFF: it is blocked at the app edge. The app logs a loud warning at boot if this is true
# in a production-like environment.
MCA_INTERNAL_TIER_ENABLED=false

# ---------------------------------------------------------------------------
# Assistant (Tabby) — Claude primary, Groq fallback.
# If the active backend is unreachable, only the chat panel is affected; maps, analysis,
# compare and exports are unchanged.
# ---------------------------------------------------------------------------
MCA_LLM_PROVIDER=anthropic
MCA_ANTHROPIC_API_KEY=__your anthropic key__
MCA_ANTHROPIC_MODEL=claude-sonnet-5

# Failover: the OpenAI-compatible client pointed at Groq. Chosen independently of the
# primary, so this pair composes with the Anthropic block above. The fallback activates
# only when BOTH MCA_LLM_FALLBACK_BASE_URL and MCA_LLM_FALLBACK_MODEL are set — the
# MCA_LLM_* (non-FALLBACK) values below configure the *primary* openai path and exist here
# only for the Groq-only bring-up swap described next.
MCA_LLM_FALLBACK_PROVIDER=openai
MCA_LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
MCA_LLM_FALLBACK_MODEL=openai/gpt-oss-120b
MCA_LLM_FALLBACK_API_KEY=__your groq key__
MCA_LLM_BASE_URL=https://api.groq.com/openai/v1
MCA_LLM_MODEL=openai/gpt-oss-120b
MCA_LLM_API_KEY=__your groq key__

# Groq-only bring-up: if the Anthropic key does not exist yet, set MCA_LLM_PROVIDER=openai
# and leave MCA_ANTHROPIC_API_KEY blank — the Groq values above then serve as the primary.
# Swap the provider back (and restart) the moment the Anthropic key is in hand; nothing
# else in this file changes. Do NOT point this at the ThinkPad's local llama-swap on :8080:
# that model serves the personal instance and would put a public queue in front of it.

# ---------------------------------------------------------------------------
# Everything else
# ---------------------------------------------------------------------------
# Nominatim requires an identifiable contact in production; the app refuses to boot without
# one. Use an address you actually read — it is where OSM would write about traffic.
MCA_GEOCODER_CONTACT_EMAIL=__your email__

# Optional: raise Socrata ingest rate limits (the nightly sidecar works without it).
SOCRATA_APP_TOKEN=

# Optional: how many days a layer may lag before GET /health/data reports it stale (503) to
# the uptime monitor. Default 7. Uncomment only to widen or tighten that alert. Worth
# widening here if the ThinkPad is regularly off overnight and misses the 03:10 ingest.
# MCA_DATA_STALENESS_DAYS=7

# Sliding expiry is capped this many days after signed issuance; a visitor past the ceiling
# receives a new pseudonymous identity.
MCA_SESSION_ABSOLUTE_MAX_DAYS=30
# The nightly 03:50 sweep removes server rows only for identities with no create/resume,
# analysis, place creation/update, upload, staging write, or stop creation in this many days.
# This includes abandoned clusters of every origin; SPD incident data is never touched.
# Set 0 to disable the session-data sweep.
MCA_SESSION_DATA_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# The edge — this is what makes the site public.
# ---------------------------------------------------------------------------
# Connector token for the NAMED tunnel, copied from Cloudflare Zero Trust >
# Networks > Tunnels > (your tunnel) > Install connector. It is a credential: it identifies
# the tunnel and authorizes routing traffic to it, so treat it like a password and rotate it
# from the dashboard if it ever leaks. docker-compose.tunnel.yml refuses to render without it.
#
# Unlike the demo's quick tunnel, the hostname is durable: compcat.app keeps resolving through
# this tunnel across restarts, reboots and reconnects.
CLOUDFLARE_TUNNEL_TOKEN=__paste the connector token from the Cloudflare dashboard__

# Absolute URLs for link-preview metadata, baked into the frontend at image build time.
# Leave as-is for compcat.app; unset would render the OG tags with relative paths, which
# most link unfurlers ignore.
VITE_CANONICAL_ORIGIN=https://compcat.app
