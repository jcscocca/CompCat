# CompCat production edge. Mounted read-only into the caddy service by
# docker-compose.prod.yml; Caddy obtains and renews the Let's Encrypt certificate for this
# name automatically, provided the A record points here and 80/443 are open.
#
# Deliberately three directives. Anything more is another thing to review before a deploy.
compcat.app {
	encode gzip
	# Hard body cap at the outer edge. The largest legitimate request is the 200 KB
	# bulk-places CSV (personal uploads are off on the public instance), so 1 MB is
	# generous. The app enforces the same default before routing; this edge rejects before
	# the request crosses the compose network.
	request_body {
		max_size 1MB
	}
	reverse_proxy api:8000 {
		# Caddy is not Cloudflare: strip client-sent CF-Connecting-IP so the app cannot
		# accept a forged value under MCA_TRUST_PROXY_HEADERS.
		header_up -CF-Connecting-IP
		# The VPS env separately opts into XFF. Pin it to one authoritative value so a
		# future trusted_proxies addition cannot hand the leftmost hop to clients.
		header_up X-Forwarded-For {client_ip}
	}
}
